---
import { getCollection, render } from 'astro:content';

const allQuestions = await getCollection('pmp-questions');
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PMP Mastery Blog</title>
</head>
<body style="font-family: system-ui, sans-serif; background: #f4f7f6; margin: 0; padding: 40px;">

  <div style="max-width: 800px; margin: 0 auto;">
    <header style="text-align: center; margin-bottom: 5px;">
      <h1 style="color: #0077b6; font-size: 2.5rem; margin-bottom: 5px;">📚 PMP Mastery Blog</h1>
      <p style="color: #666; font-style: italic;">Practical, Humorous, and Agent-Ready Project Management Training</p>
      <hr style="border: 0; height: 2px; background: #0077b6; margin: 30px 0;" />
    </header>

    <main>
      <h2 style="margin-bottom: 30px; color: #444;">Latest Practice Questions</h2>

      {allQuestions.map(async (item) => {
        const { Content } = await render(item);
        return (
          <article style="background: white; padding: 30px; border-radius: 12px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border-left: 5px solid #0077b6;">
            <header style="margin-bottom: 20px;">
              <span style="background: #0077b6; color: white; padding: 5px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: bold; text-transform: uppercase;">
                {item.data.category}
              </span>
              <span style="margin-left: 15px; color: #888; font-size: 0.9rem;">
                Difficulty: {item.data.difficulty}/5
              </span>
              <h3 style="margin-top: 15px; font-size: 1.8rem; color: #222;">{item.data.title}</h3>
            </header>
            
            <div class="pmp-content" style="color: #4a5568; line-height: 1.6;">
              <Content />
            </div>
          </article>
        );
      })}
    </main>

    <footer style="text-align: center; margin-top: 50px; color: #888; font-size: 0.9rem;">
      <p>© 2026 Noteskeep.com | Built with Astro & AI-Ready Logic</p>
    </footer>
  </div>

</body>
</html>
